# Monochromatic beam example
/control/verbose 1
/run/verbose 1

# --- geometry: BEFORE /run/initialize ---
/tgt/det/material  G4_W
/tgt/det/thickness 20 um
/tgt/det/zCenter   -1.1 mm
/tgt/det/width     100 mm

# Production cut (range). Secondaries below the corresponding energy
# threshold are not created as tracks. The Geant4 default is 0.7 mm, which
# is large compared with the 20 um foil. Thresholds are printed at init.
/run/setCut 10 um

/run/initialize

# --- beam: AFTER /run/initialize ---
# One event = one bunch: current * bunchTime / e electrons (1498 at 120 nA, 2 ns)
/tgt/gun/current 120 nA
/tgt/gun/bunchTime 2 ns
/gun/particle e-
/tgt/gun/energy 3.74 GeV
/tgt/gun/thetaX 30.5 mrad
/tgt/gun/thetaY 0 mrad
/tgt/gun/sigmaX 0 mm
/tgt/gun/sigmaY 0 mm

# --- output ---
/tgt/created/record true
# Filter on particles leaving the target (exit_* columns). Defaults pass all.
#/tgt/filter/chargedEmin 50 MeV
#/tgt/filter/thetaYmin 15 mrad
#/tgt/filter/thetaYmax 80 mrad
#/tgt/filter/keepEmptyEvents false
/analysis/setFileName target_mono

/run/printProgress 1000
/run/beamOn 100000
