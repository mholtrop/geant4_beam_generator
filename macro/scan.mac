# Energy and angle ranges example
/control/verbose 1
/run/verbose 1

/tgt/det/thickness 20 um
/tgt/det/zCenter   -1.1 mm
/run/setCut 10 um
/run/initialize

/gun/particle e-
/tgt/gun/current 120 nA
/tgt/gun/bunchTime 2 ns
/tgt/gun/Emin 0.2 GeV
/tgt/gun/Emax 5.0 GeV
/tgt/gun/thetaXmin -20 mrad
/tgt/gun/thetaXmax  80 mrad
/tgt/gun/thetaYmin -10 mrad
/tgt/gun/thetaYmax  10 mrad
/tgt/gun/sigmaX 0.1 mm
/tgt/gun/sigmaY 0.02 mm

/analysis/setFileName target_scan
/run/printProgress 100
/run/beamOn 1000
